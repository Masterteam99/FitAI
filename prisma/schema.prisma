generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum FitnessLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ATHLETE
}

enum FitnessGoal {
  LOSE_WEIGHT
  BUILD_MUSCLE
  ENDURANCE
  FLEXIBILITY
  GENERAL_FITNESS
  ATHLETIC_PERFORMANCE
}

enum Equipment {
  NONE
  DUMBBELLS
  BARBELL
  MACHINE
  RESISTANCE_BANDS
  PULL_UP_BAR
  BENCH
  KETTLEBELL
  CABLES
  FULL_GYM
}

enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  BICEPS
  TRICEPS
  FOREARMS
  CORE
  QUADRICEPS
  HAMSTRINGS
  GLUTES
  CALVES
  FULL_BODY
}

enum ExerciseCategory {
  STRENGTH
  CARDIO
  FLEXIBILITY
  BALANCE
  PLYOMETRIC
  FUNCTIONAL
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AnalysisStatus {
  RECORDING
  PROCESSING
  COMPLETED
  ERROR
}

enum ThresholdSeverity {
  WARNING
  ERROR
  CRITICAL
}

enum ExercisePhase {
  CONCENTRIC
  ECCENTRIC
  ISOMETRIC
  TOP
  BOTTOM
  THROUGHOUT
}

enum TriggerCondition {
  BELOW_MIN
  ABOVE_MAX
  OUT_OF_RANGE
}

enum AchievementRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum PostType {
  WORKOUT_SHARE
  ACHIEVEMENT
  PROGRESS_PHOTO
  CHALLENGE_COMPLETION
}

enum ProfileVisibility {
  PUBLIC
  PRIVATE
}

enum SubscriptionStatus {
  FREE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum SubscriptionPlan {
  MONTHLY
  YEARLY
}

enum ChallengeType {
  STREAK
  VOLUME
  FREQUENCY
  SPECIFIC_EXERCISE
}

enum NotificationType {
  ACHIEVEMENT
  REMINDER
  SOCIAL
  CHALLENGE
  AI_TIP
}

enum WearablePlatform {
  APPLE_HEALTH
  GOOGLE_FIT
  FITBIT
  GARMIN
}

enum AdminActionType {
  PROMOTE_ADMIN
  REVOKE_ADMIN
  GRANT_PREMIUM
  RESET_USER_QUOTA
  TOGGLE_EXERCISE_ACTIVE
  UPLOAD_PT_VIDEO
  DELETE_PT_VIDEO
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id                  String       @id @default(cuid())
  email               String       @unique
  emailVerified       DateTime?
  name                String?
  avatar              String?
  image               String?
  passwordHash        String?
  isAdmin             Boolean      @default(false)
  profileVisibility   ProfileVisibility @default(PUBLIC)
  stripeCustomerId    String?      @unique
  subscriptionStatus  SubscriptionStatus @default(FREE)
  subscriptionPlan    SubscriptionPlan?
  subscriptionCurrentPeriodEnd DateTime?
  premiumGrantedUntil DateTime?
  fitnessLevel        FitnessLevel @default(BEGINNER)
  age                 Int?
  weightKg            Float?
  heightCm            Float?
  gender              String?
  primaryGoal         FitnessGoal  @default(GENERAL_FITNESS)
  availableEquipment  Equipment[]  @default([NONE])
  weeklyWorkoutDays   Int          @default(3)
  dietType            String? // onnivora, vegetariana, vegana, chetogenica, mediterranea, altro
  pastInjuries        String[]     @default([]) // array libero
  pastSports          String[]     @default([]) // multi-select
  medicalNotes        String? // note mediche facoltative scritte dall'utente (testo libero, nessun file)
  nutritionPlanJson   Json?
  onboardingCompleted Boolean      @default(false)
  notifyEmailReminders Boolean     @default(true)
  notifyPush          Boolean      @default(false)
  totalPoints         Int          @default(0)
  currentStreak       Int          @default(0)
  longestStreak       Int          @default(0)
  lastWorkoutDate     DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  accounts              Account[]
  authSessions          AuthSession[]
  passwordResetTokens   PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  subscriptions         Subscription[]
  usageCounters         UsageCounter[]
  workoutPlans          WorkoutPlan[]
  workoutSessions       WorkoutSession[]
  analysisSessions      AnalysisSession[]
  progressEntries       UserProgress[]
  nutritionLogs         NutritionLog[]
  achievements          UserAchievement[]
  socialPosts           SocialPost[]
  socialLikes           SocialLike[]
  socialComments        SocialComment[]
  documents             UserDocument[]
  challengeParticipants ChallengeParticipant[]
  notifications         Notification[]
  wearables             WearableIntegration[]
  dailyCheckins         DailyCheckin[]
  revisionRequests      RevisionRequest[]
  adminActions          AdminActionLog[]      @relation("AdminActionActor")
  pushSubscriptions     PushSubscription[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model AuthSession {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  token      String    @unique
  userId     String
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("email_verification_tokens")
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String
  stripeSubscriptionId String             @unique
  stripePriceId        String
  status               SubscriptionStatus
  plan                 SubscriptionPlan
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("subscriptions")
}

model UsageCounter {
  id        String   @id @default(cuid())
  userId    String
  feature   String
  period    String
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, feature, period])
  @@index([userId])
  @@map("usage_counters")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Exercise {
  id                       String           @id @default(cuid())
  name                     String
  slug                     String           @unique
  description              String           @db.Text
  instructions             String[]
  muscleGroupPrimary       MuscleGroup
  muscleGroupsSecondary    MuscleGroup[]    @default([])
  difficulty               Difficulty
  equipment                Equipment[]      @default([NONE])
  category                 ExerciseCategory
  videoUrl                 String? // VIDEO_RIF_1: video PT pro per riferimento e Logica 3
  explanationVideoUrl      String? // video del professionista che spiega l'esecuzione (consigli)
  thumbnailUrl             String?
  durationSeconds          Int?
  recordingDurationSeconds Int              @default(20) // 15-25s, durata acquisizione video utente per analisi
  caloriesPerMinute        Float            @default(5)
  professionalNotes        String?          @db.Text
  referenceProfile         Json? // profilo biomeccanico PT (angoli per giunto/fase)
  referenceProfileAt       DateTime? // quando generato
  referenceProfileVersion  Int? // = REFERENCE_PROFILE_VERSION, per invalidazione
  tags                     String[]         @default([])
  isActive                 Boolean          @default(true)
  availableForFreeTrial    Boolean          @default(false) // selezionabile nel flusso "prova gratuita" per ospiti (non loggati)
  createdAt                DateTime         @default(now())

  biomechanicalSpec    ExerciseBiomechanicalSpec?
  planExercises        WorkoutPlanExercise[]
  sessionExercises     WorkoutSessionExercise[]
  analysisSessions     AnalysisSession[]
  guestAnalysisRequests GuestAnalysisRequest[]

  @@index([muscleGroupPrimary])
  @@index([difficulty])
  @@index([category])
  @@map("exercises")
}

// ─── Analisi v2: gerarchia spec biomeccanica per esercizio ────────────────────
// Struttura: Spec → Movements (per joint) → Phases (per fase movimento) → Triggers (regole)

model ExerciseBiomechanicalSpec {
  id         String             @id @default(cuid())
  exerciseId String             @unique
  exercise   Exercise           @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  movements  ExerciseMovement[]

  @@map("exercise_biomechanical_specs")
}

model ExerciseMovement {
  id           String                    @id @default(cuid())
  specId       String
  spec         ExerciseBiomechanicalSpec @relation(fields: [specId], references: [id], onDelete: Cascade)
  joint        String // left_knee, right_knee, spine, ecc. (vedi src/lib/pose.ts::KEYPOINT_NAMES)
  movementType String // flessione, estensione, abduzione, rotazione, inclinazione, cerniera, neutrale
  phases       MovementPhase[]

  @@index([specId])
  @@map("exercise_movements")
}

model MovementPhase {
  id         String           @id @default(cuid())
  movementId String
  movement   ExerciseMovement @relation(fields: [movementId], references: [id], onDelete: Cascade)
  phase      ExercisePhase // CONCENTRIC, ECCENTRIC, ISOMETRIC, TOP, BOTTOM, THROUGHOUT
  minAngle   Float
  maxAngle   Float
  triggers   PhaseTrigger[]

  @@index([movementId])
  @@map("movement_phases")
}

model PhaseTrigger {
  id         String            @id @default(cuid())
  phaseId    String
  phase      MovementPhase     @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  condition  TriggerCondition // BELOW_MIN, ABOVE_MAX, OUT_OF_RANGE
  severity   ThresholdSeverity // WARNING, ERROR, CRITICAL
  feedback   String            @db.Text
  injuryRisk Boolean           @default(false)

  @@index([phaseId])
  @@map("phase_triggers")
}

model WorkoutPlan {
  id              String           @id @default(cuid())
  userId          String
  name            String
  description     String?          @db.Text
  generatedByAI   Boolean          @default(false)
  aiPromptUsed    String?          @db.Text
  difficulty      Difficulty       @default(INTERMEDIATE)
  durationWeeks   Int              @default(4)
  workoutsPerWeek Int              @default(3)
  primaryGoal     FitnessGoal      @default(GENERAL_FITNESS)
  isActive        Boolean          @default(false)
  isPublic        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  days            WorkoutPlanDay[]
  sessions        WorkoutSession[]

  @@index([userId])
  @@map("workout_plans")
}

model WorkoutPlanDay {
  id        String                @id @default(cuid())
  planId    String
  dayNumber Int
  name      String
  restDay   Boolean               @default(false)
  plan      WorkoutPlan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  exercises WorkoutPlanExercise[]
  sessions  WorkoutSession[]

  @@index([planId])
  @@map("workout_plan_days")
}

model WorkoutPlanExercise {
  id              String         @id @default(cuid())
  planDayId       String
  exerciseId      String
  orderIndex      Int
  sets            Int            @default(3)
  reps            Int?
  durationSeconds Int?
  restSeconds     Int            @default(60)
  notes           String?
  targetWeightKg  Float?
  planDay         WorkoutPlanDay @relation(fields: [planDayId], references: [id], onDelete: Cascade)
  exercise        Exercise       @relation(fields: [exerciseId], references: [id])

  @@index([planDayId])
  @@map("workout_plan_exercises")
}

model WorkoutSession {
  id             String                   @id @default(cuid())
  userId         String
  planId         String?
  planDayId      String?
  status         SessionStatus            @default(IN_PROGRESS)
  startedAt      DateTime                 @default(now())
  completedAt    DateTime?
  totalSeconds   Int?
  totalVolumeKg  Float?
  caloriesBurned Int?
  notes          String?                  @db.Text
  overallFeeling Int?
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan           WorkoutPlan?             @relation(fields: [planId], references: [id])
  planDay        WorkoutPlanDay?          @relation(fields: [planDayId], references: [id])
  exercises      WorkoutSessionExercise[]
  analysisSessions AnalysisSession[]

  @@index([userId])
  @@index([planId])
  @@map("workout_sessions")
}

model WorkoutSessionExercise {
  id            String         @id @default(cuid())
  sessionId     String
  exerciseId    String
  orderIndex    Int
  completedSets Json           @default("[]")
  session       WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise      Exercise       @relation(fields: [exerciseId], references: [id])
  analysisSessions AnalysisSession[]

  @@index([sessionId])
  @@map("workout_session_exercises")
}

model AnalysisSession {
  id              String         @id @default(cuid())
  userId          String
  exerciseId      String
  status          AnalysisStatus @default(RECORDING)
  videoUrl        String? // URL Supabase Storage del video utente (15-25s)
  videoPath       String? // path nel bucket analysis-videos (serve per poterlo eliminare su richiesta utente)
  durationSeconds Int?
  startedAt       DateTime       @default(now())
  completedAt     DateTime?

  // Collegamento facoltativo alla sessione di allenamento del piano (se l'analisi è stata fatta
  // dentro il flusso guidato "La tua sessione" invece che come analisi isolata da /analisi).
  workoutSessionId         String?
  workoutSessionExerciseId String?

  // Analisi v2 — output strutturati per logica + sintesi finale
  l1Result      Json? // L1Result: score, triggeredFeedback, detectedPhases, rawAngles
  l2Result      Json? // L2Result: score, qualitativeAnalysis, visualObservations, injuryRiskFlags
  l3Result      Json? // L3Result: score, comparisonFeedback, keyDifferences
  finalReport   Json? // FinalReport: combinedScore, overallJudgment, prioritizedImprovements, injuryRiskAlert, positiveAspects
  combinedScore Float? // Manteniamo top-level per query/index veloci

  user                   User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise               Exercise                 @relation(fields: [exerciseId], references: [id])
  workoutSession         WorkoutSession?          @relation(fields: [workoutSessionId], references: [id], onDelete: SetNull)
  workoutSessionExercise WorkoutSessionExercise?  @relation(fields: [workoutSessionExerciseId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([exerciseId])
  @@index([workoutSessionId])
  @@index([workoutSessionExerciseId])
  @@map("analysis_sessions")
}

// ─── Prova gratuita per ospiti (pre-utenti, non loggati) ──────────────────────
// Stessa pipeline di analisi (L1/L2/L3 + report finale) dell'AnalysisSession,
// ma senza account: identificata da un token capability in cookie httpOnly
// invece che dalla sessione NextAuth. Il referto viene inviato via email.
model GuestAnalysisRequest {
  id              String         @id @default(cuid())
  email           String
  exerciseId      String
  consentAt       DateTime       @default(now())
  ipHash          String? // hash IP per rate limiting/abuso, mai l'IP in chiaro
  status          AnalysisStatus @default(RECORDING)
  videoUrl        String?
  videoPath       String?
  durationSeconds Int?

  l1Result      Json?
  l2Result      Json?
  l3Result      Json?
  finalReport   Json?
  combinedScore Float?
  reportSentAt  DateTime?

  createdAt DateTime @default(now())

  exercise Exercise @relation(fields: [exerciseId], references: [id])

  @@index([email])
  @@index([exerciseId])
  @@index([createdAt])
  @@map("guest_analysis_requests")
}

model UserProgress {
  id                 String   @id @default(cuid())
  userId             String
  date               DateTime @default(now())
  weightKg           Float?
  bodyFatPercent     Float?
  measurementChestCm Float?
  measurementWaistCm Float?
  measurementHipsCm  Float?
  measurementArmsCm  Float?
  measurementLegsCm  Float?
  photoUrl           String?
  notes              String?
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_progress")
}

model NutritionLog {
  id       String   @id @default(cuid())
  userId   String
  date     DateTime @default(now())
  mealType MealType
  foodName String
  quantity Float
  unit     String   @default("g")
  calories Float
  proteinG Float    @default(0)
  carbsG   Float    @default(0)
  fatG     Float    @default(0)
  fiberG   Float    @default(0)
  notes    String?
  foodId   String?
  food     Food?    @relation(fields: [foodId], references: [id], onDelete: SetNull)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
  @@map("nutrition_logs")
}

// Pool alimenti: valori nutrizionali per 100g, usato per il diario alimentare
// (l'utente inserisce solo la grammatura, calorie/macro si calcolano da qui).
// Popolato inizialmente da un dataset pubblico (USDA/valori standard per
// alimenti generici), gestibile/estendibile da Admin → Alimenti.
model Food {
  id              String         @id @default(cuid())
  name            String
  nameNormalized  String         @unique
  category        String?
  caloriesPer100g Float
  proteinPer100g  Float
  carbsPer100g    Float
  fatPer100g      Float
  fiberPer100g    Float          @default(0)
  source          String         @default("curated")
  createdAt       DateTime       @default(now())
  logs            NutritionLog[]

  @@index([nameNormalized])
  @@map("foods")
}

model DailyCheckin {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime // UTC midnight della data del check-in
  mood      Int      // 1-5
  note      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("daily_checkins")
}

model Achievement {
  id               String            @id @default(cuid())
  key              String            @unique
  name             String
  description      String
  icon             String
  category         String
  condition        Json
  points           Int               @default(10)
  rarity           AchievementRarity @default(COMMON)
  userAchievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id               String      @id @default(cuid())
  userId           String
  achievementId    String
  unlockedAt       DateTime    @default(now())
  notificationSent Boolean     @default(false)
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement      Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
  @@index([userId])
  @@map("user_achievements")
}

model Challenge {
  id           String                 @id @default(cuid())
  creatorId    String?
  title        String
  description  String                 @db.Text
  type         ChallengeType
  target       Json
  startDate    DateTime
  endDate      DateTime
  isPublic     Boolean                @default(true)
  reward       Json?
  participants ChallengeParticipant[]

  @@index([startDate])
  @@map("challenges")
}

model ChallengeParticipant {
  id              String    @id @default(cuid())
  challengeId     String
  userId          String
  currentProgress Json      @default("{}")
  completedAt     DateTime?
  rank            Int?
  challenge       Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([userId])
  @@map("challenge_participants")
}

model SocialPost {
  id               String       @id @default(cuid())
  userId           String
  type             PostType
  content          String       @db.Text
  workoutSessionId String?
  achievementId    String?
  imageUrl         String?
  likesCount       Int          @default(0)
  createdAt        DateTime     @default(now())
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes            SocialLike[]
  comments         SocialComment[]

  @@index([userId])
  @@index([createdAt])
  @@map("social_posts")
}

model SocialComment {
  id        String     @id @default(cuid())
  postId    String
  userId    String
  content   String     @db.Text
  createdAt DateTime   @default(now())
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("social_comments")
}

model SocialLike {
  id        String     @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime   @default(now())
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("social_likes")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model WearableIntegration {
  id           String           @id @default(cuid())
  userId       String
  platform     WearablePlatform
  accessToken  String           @db.Text
  refreshToken String?          @db.Text
  lastSyncAt   DateTime?
  isActive     Boolean          @default(true)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@map("wearable_integrations")
}

model WorkoutPlanTemplate {
  id                String        @id @default(cuid())
  name              String
  description       String        @db.Text
  difficulty        FitnessLevel
  targetGoals       FitnessGoal[]
  requiredEquipment Equipment[]
  durationWeeks     Int
  workoutsPerWeek   Int
  rationale         String        @db.Text
  daysJson          Json
  createdAt         DateTime      @default(now())

  @@index([difficulty])
}

model NutritionPlanTemplate {
  id                   String      @id @default(cuid())
  name                 String
  description          String      @db.Text
  dietType             String
  targetGoal           FitnessGoal
  estimatedProfileJson Json
  targetMacrosJson     Json
  weeklyPlanJson       Json
  rationale            String      @db.Text
  createdAt            DateTime    @default(now())

  @@index([dietType, targetGoal])
}

model AdminActionLog {
  id          String          @id @default(cuid())
  actorId     String
  actorEmail  String
  action      AdminActionType
  targetType  String
  targetId    String?
  payload     Json?
  createdAt   DateTime        @default(now())

  actor       User            @relation("AdminActionActor", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([createdAt])
  @@index([action])
}

model RevisionRequest {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      RevisionType
  message   String
  status    RevisionStatus @default(PENDING)
  createdAt DateTime       @default(now())

  @@index([userId])
  @@index([status])
  @@map("revision_requests")
}

enum RevisionType {
  FITNESS
  NUTRITION
}

enum RevisionStatus {
  PENDING
  REVIEWED
}

model QuizConfig {
  id            String   @id
  questionsJson Json
  updatedAt     DateTime @updatedAt

  @@map("quiz_config")
}

// Override editabili dei copy del sito (chiave dot-path es. "prezzi.premiumPrice").
// Le pagine leggono l'override dal DB se presente, altrimenti il default da copy.ts.
// Consente al gestore di modificare titoli/sottotitoli/CTA/prezzi senza deploy.
model SiteContent {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("site_content")
}

// Premi della classifica (gamification), gestiti dall'Admin. La classifica stessa
// non ha un modello dedicato: è calcolata al volo da User.totalPoints, filtrando
// solo i profili con profileVisibility=PUBLIC (lo stesso flag già usato per la
// Community, riusato qui come opt-in privacy).
model LeaderboardReward {
  id          String   @id @default(cuid())
  rankFrom    Int // es. 1
  rankTo      Int // es. 3 → premio per le posizioni 1-3
  title       String // es. "Un mese Premium gratis"
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([isActive])
  @@map("leaderboard_rewards")
}

// Pool di ricette curate dal gestore. Mostrate all'utente in base alla dieta;
// l'AI resta come fallback quando non ci sono ricette curate pertinenti.
model Recipe {
  id          String    @id @default(cuid())
  title       String
  description String    @db.Text
  mealType    MealType? // BREAKFAST/LUNCH/DINNER/SNACK — facoltativo
  dietType    String? // onnivora/vegetariana/vegana/... — null = adatta a tutte
  calories    Int?
  proteinG    Int?
  carbsG      Int?
  fatG        Int?
  ingredients String[]  @default([])
  steps       String[]  @default([])
  tags        String[]  @default([])
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@index([dietType])
  @@index([isActive])
  @@map("recipes")
}

model UserDocument {
  id           String       @id @default(cuid())
  userId       String
  kind         DocumentKind
  name         String
  path         String
  analysisJson Json? // analisi AI del documento (sintesi + aggiustamenti consigliati fitness/nutrizione)
  analyzedAt   DateTime? // quando è stata generata l'analisi AI
  createdAt    DateTime     @default(now())
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_documents")
}

enum DocumentKind {
  FITNESS
  NUTRITION
}
